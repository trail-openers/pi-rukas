{
  "name": "@trail-openers/pi-rukas",
  "version": "0.15.1",
  "description": "Multi-specialist orchestrator extension for Pi — parallel worktree-isolated dispatch, adversarial gate, six-pass code review.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "ai-agent",
    "multi-agent",
    "code-review",
    "orchestrator"
  ],
  "license": "Apache-2.0",
  "author": "Janni Turunen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trail-openers/pi-rukas.git"
  },
  "bugs": {
    "url": "https://github.com/trail-openers/pi-rukas/issues"
  },
  "homepage": "https://github.com/trail-openers/pi-rukas#readme",
  "pi": {
    "extensions": [
      "./extension/index.ts"
    ],
    "skills": [
      "./skill"
    ]
  },
  "files": [
    "extension/index.ts",
    "extension/package.json",
    "extension/src/",
    "extension/scripts/review-accept.ts",
    "agents.json",
    "dist/prompts/standard/",
    "docs/",
    "pi-prompts/",
    "skill/",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "install:all": "./install.sh",
    "build": "PI_ENSEMBLE_BASE=$PWD PROMPTS_DIR=$PWD/dist/prompts ./build.sh standard",
    "check": "cd extension && bun run check",
    "test": "cd extension && bun run smoke-tests/test-command-flow.ts && bun run smoke-tests/test-lens-review.ts && bun run smoke-tests/test-models.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.32.0"
  }
}
