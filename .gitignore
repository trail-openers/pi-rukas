# Dependencies
node_modules/
extension/node_modules/

# Built artefacts (regenerated by `bun run build`)
dist/prompts/

# OS / editor noise
.DS_Store
*.swp
*~
.idea/
.vscode/

# Local debug overrides
.env
.env.local

# Run artefacts (live tests can leave temp dirs)
/tmp-*/
.worktrees/

# pi-ensemble permission config (user-specific)
.pi/permissions.json
.pi/decisions.json

# /work driver workflow state (per-issue, per-project), and the plan driver's
# dropped-items artifacts under .pi/work-state/plan-dropped/ (#1383) — the
# full list behind the bounded `## Dropped investigation items` section, which
# the filed spec names. Durable per-clone operator state, never committed.
# In a project that has no .gitignore entry for it, the same tree is kept out
# of `git status` by the per-clone .git/info/exclude entry the harness writes
# (work-driver-git-exclude.ts).
.pi/work-state/

# Research artefacts from workflow runs — local working material, not shipped.
outputs/
.feynman/
.pi-subagents/
