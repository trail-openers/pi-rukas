#!/usr/bin/env bash
#
# pi-rukas — launch pi inside the sandboxed Docker container.
#
# The container fence IS the trust boundary: inside, all permission gating is
# disabled (PI_ENSEMBLE_SANDBOX_MODE=1) so the user is never prompted for a
# tool call. Host state that should survive across sessions is bind-mounted:
#
#   - $HOME/.vipune/                       → /home/vscode/.vipune
#       (cross-session project memory; preserves your accumulated vipune store)
#   - $HOME/.pi/agent/ensemble-runs/       → /home/vscode/.pi/agent/ensemble-runs
#   - $HOME/.pi/agent/sessions/            → /home/vscode/.pi/agent/sessions
#   - $HOME/.pi/agent/ensemble-models.json → same path (per-role model picks)
#   - $HOME/.pi/agent/mcp.json             → same path (RO, native MCP, issue #959)
#   - $HOME/.config/gh/                    → same path (RO; gh auth — or set GH_TOKEN)
#
# Caches (~/.cache, ~/.bun, ~/.cargo, shell history) live in named volumes
# shared across projects. Per-mount rationale: see build_mounts() below.
#
# Subcommands:
#   (none)        Interactive `pi` session in the container (default)
#   -r, --resume  Pass through to `pi -r` — resume a previous sandbox
#                 session for this project. Forwarded as a flag, not a
#                 subcommand.
#   shell         Drop into bash inside the container
#   rebuild       Rebuild the pi-rukas image
#   stop          Stop the running container for this project
#   prune         Remove named volumes (DESTROYS sandbox caches — vipune/runs/
#                 sessions stay safe because they're bind-mounted from host)
#   logs          Tail container logs
#   status        Show whether a container is running for this project
#   --help        Show this help

set -euo pipefail

# Resolve this script's real dir, following any symlink chain (relative → link's own dir).
_link="${BASH_SOURCE[0]}"; while [ -L "$_link" ]; do _tgt="$(readlink "$_link")"
  case "$_tgt" in /*) _link="$_tgt" ;; *) _link="$(cd "$(dirname "$_link")" && pwd -P)/$_tgt" ;; esac; done
PI_RUKAS_DIR="$(cd "$(dirname "$_link")" && pwd -P)"; REPO_DIR="$(dirname "$PI_RUKAS_DIR")"
source "$PI_RUKAS_DIR/lib-pi-rukas-shell.sh"

IMAGE="${PI_ENSEMBLE_IMAGE:-ghcr.io/trail-openers/pi-rukas:latest}"
PROJECT_ROOT="$(cd "$(pwd)" && pwd -P)"
PROJECT_NAME="$(basename "$PROJECT_ROOT" | tr -c 'A-Za-z0-9._-' '-' | head -c 40)"
# Project-hash so concurrent `pi-rukas` calls in DIFFERENT projects get
# distinct container-name prefixes. Same-project concurrency relies on the
# RUN_SUFFIX below, not this hash.
PROJECT_HASH="$(printf '%s' "$PROJECT_ROOT" | shasum -a 256 | cut -c1-12)"
# BASE_NAME identifies the project; CONTAINER_NAME identifies the specific
# `pi-rukas` invocation. The RUN_SUFFIX lets two terminals open sessions
# in the same project without colliding on the docker --name flag. The
# stop/status/logs subcommands enumerate `${BASE_NAME}-*` to find sessions.
BASE_NAME="pi-rukas-${PROJECT_NAME}-${PROJECT_HASH}"
RUN_SUFFIX="$(head -c 4 /dev/urandom | xxd -p)"
CONTAINER_NAME="${BASE_NAME}-${RUN_SUFFIX}"

usage() {
  sed -n '/^#$/,/^$/p' "$0" | grep -E '^#' | sed 's/^# \{0,1\}//'
  exit 0
}

require_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    cat >&2 <<EOF
!! Docker not found on PATH.
   pi-rukas (sandbox mode) needs Docker Desktop, Colima, or another
   docker-compatible runtime. Install one of:
     - Docker Desktop  https://docker.com
     - Colima (macOS)  brew install colima && colima start
     - OrbStack (macOS, paid)  https://orbstack.dev
   Alternatively, use host-mode \`pi\` directly (with the legacy permission
   system).
EOF
    exit 2
  fi
  if ! docker info >/dev/null 2>&1; then
    echo "!! Docker is installed but the daemon isn't running. Start Docker and retry." >&2
    exit 2
  fi
}

ensure_image() {
  if docker image inspect "$IMAGE" >/dev/null 2>&1; then
    return  # already cached locally
  fi
  # Prefer pull from the registry (GHCR auto-publishes on every merge to main
  # via .github/workflows/publish-image.yml). Fall back to local build for
  # offline / unpublished-image / dev scenarios — no regression for users
  # actively iterating on the Dockerfile.
  echo "==> Image $IMAGE not present locally. Pulling from registry..."
  if docker pull "$IMAGE"; then
    return
  fi
  echo "==> Pull failed. Falling back to local build from pi-rukas repo..."
  docker build -t "$IMAGE" -f "$REPO_DIR/.devcontainer/Dockerfile" "$REPO_DIR"
}

build_mounts() {
  # Assembles the -v flags; the caller eval's the NUL-separated output.
  #
  # Principle: the sandbox MUST NOT require the host to have pi-rukas's
  # toolchain installed (Docker is the only host prereq). Where the host has
  # existing state (vipune memories, transcripts, model picks, gh auth, ...)
  # we bind-mount it through for continuity; where the host has nothing we
  # fall back to named volumes so the container still gets persistent,
  # container-scoped state.
  local mounts=()
  # Mount the project at its HOST ABSOLUTE PATH, not /workspace: Pi scopes
  # sessions by absolute cwd, so a project run in host mode and the same
  # project in sandbox mode must share cwd to share the sessions/<scope>
  # bucket. Pre-#207 we mounted at /workspace and every project's sandbox
  # sessions co-mingled into one `--workspace--` bucket, breaking `pi-rukas -r`.
  # Post-#207: host cwd == container cwd → per-project isolation restored,
  # host↔sandbox cross-resume works.
  mounts+=(-v "$PROJECT_ROOT:$PROJECT_ROOT:delegated")

  # vipune — bind-mount if present (preserves accumulated memories),
  # else named volume (persists across container runs).
  if [ -d "$HOME/.vipune" ]; then
    mounts+=(-v "$HOME/.vipune:/home/vscode/.vipune")
  else
    mounts+=(-v pi-ensemble-vipune:/home/vscode/.vipune)
  fi

  # ensemble-runs transcripts — same pattern. /runs slash command browses
  # these, so persisting them across container restarts is the user
  # expectation regardless of host state.
  if [ -d "$HOME/.pi/agent/ensemble-runs" ]; then
    mounts+=(-v "$HOME/.pi/agent/ensemble-runs:/home/vscode/.pi/agent/ensemble-runs")
  else
    mounts+=(-v pi-ensemble-runs:/home/vscode/.pi/agent/ensemble-runs)
  fi

  # Pi sessions — `pi -r` reads these. NOTE: Pi scopes sessions by absolute
  # project path, and the same project can live at different paths on host
  # vs. in the container — so host and sandbox sessions live in DIFFERENT
  # sub-buckets and don't cross-resume. Within each mode: `pi -r` / `pi-rukas -r`
  # finds previous sessions for the same project.
  if [ -d "$HOME/.pi/agent/sessions" ]; then
    mounts+=(-v "$HOME/.pi/agent/sessions:/home/vscode/.pi/agent/sessions")
  else
    mounts+=(-v pi-ensemble-sessions:/home/vscode/.pi/agent/sessions)
  fi

  # ensemble-models.json — per-role model picks. Bound RW (not :ro) so
  # /ensemble-model inside the sandbox can update picks and persist them
  # back to the host (symmetric with the sessions/ bind from PR #206).
  # Only bound if present on host; otherwise the container uses its defaults.
  if [ -f "$HOME/.pi/agent/ensemble-models.json" ]; then
    mounts+=(-v "$HOME/.pi/agent/ensemble-models.json:/home/vscode/.pi/agent/ensemble-models.json")
  fi

  # models.json — Pi's PROVIDER config (custom OpenAI-compatible endpoints).
  # Without this bind, custom providers added on host are invisible in the
  # sandbox (PR #205 regression fix). API keys interpolated from env vars
  # ("apiKey": "$TRAIL_OPENERS_LLM_KEY") rely on the env passthrough in build_env.
  if [ -f "$HOME/.pi/agent/models.json" ]; then
    mounts+=(-v "$HOME/.pi/agent/models.json:/home/vscode/.pi/agent/models.json:ro")
  fi

  # mcp.json — Pi 1.0.0's native MCP config, bind-mounted if present (issue
  # #959 moved the wiring from the adapter-era ~/.config/mcp/mcp.json to
  # ~/.pi/agent/mcp.json; matches the devcontainer.json bind-mount). Entries
  # are PATH-portable (PR #202) so the same file works in both host and
  # container contexts. If the host doesn't have one, the container's baked
  # default (codebase_memory wired) takes over.
  if [ -f "$HOME/.pi/agent/mcp.json" ]; then
    mounts+=(-v "$HOME/.pi/agent/mcp.json:/home/vscode/.pi/agent/mcp.json:ro")
  fi

  # gh auth — bind-mount fallback for installations configured without a
  # token (e.g. SSO web flow only). Primary channel is the GH_TOKEN env
  # extracted via `gh auth token` (see build_env); gh honors GH_TOKEN first.
  if [ -d "$HOME/.config/gh" ]; then
    mounts+=(-v "$HOME/.config/gh:/home/vscode/.config/gh:ro")
  fi

  # Image directories — drag-and-drop into Pi via @file syntax. Bound RO
  # at the host's absolute paths so a path pasted by the terminal (e.g.
  # /Users/you/Downloads/screenshot.png) resolves inside. sandbox-fs-guard
  # is told about these via PI_ENSEMBLE_ALLOWED_ROOTS (see build_env).
  # Default: $HOME/Downloads, $HOME/Desktop, $HOME/Pictures.
  # PI_ENSEMBLE_IMAGE_DIRS replaces the default; PI_ENSEMBLE_EXTRA_IMAGE_DIRS appends.
  local default_image_dirs="$HOME/Downloads:$HOME/Desktop:$HOME/Pictures"
  local image_dirs_raw="${PI_ENSEMBLE_IMAGE_DIRS:-$default_image_dirs}"
  if [ -n "${PI_ENSEMBLE_EXTRA_IMAGE_DIRS-}" ]; then
    image_dirs_raw="${image_dirs_raw}:${PI_ENSEMBLE_EXTRA_IMAGE_DIRS}"
  fi
  IFS=':' read -ra image_dirs <<<"$image_dirs_raw"
  for dir in "${image_dirs[@]}"; do
    [ -z "$dir" ] && continue
    [ -d "$dir" ] || continue
    mounts+=(-v "$dir:$dir:ro")
  done

  # Host docker socket — bind-mounted by default so docker-based MCP servers
  # in .pi/mcp.json work transparently (spawned MCPs are SIBLING containers
  # visible in the host's `docker ps`). Opt out with PI_ENSEMBLE_NO_DOCKER_SOCKET=1.
  # SECURITY: the socket grants root-equivalent host access, weakening the
  # container fence. Consistent with the trust-mode philosophy (#215): the
  # user is the trust authority. See AGENTS.md "Permission model".
  if [ "${PI_ENSEMBLE_NO_DOCKER_SOCKET-}" = "1" ]; then
    :  # explicit opt-out — keep the tighter sandbox
  elif [ -S /var/run/docker.sock ]; then
    mounts+=(-v "/var/run/docker.sock:/var/run/docker.sock")
  fi

  # SSH credentials — bind-mount ~/.ssh/ RO AND forward the host's
  # SSH_AUTH_SOCK so `ssh remote-host` uses the same identities as host-mode
  # pi. Opt out with PI_ENSEMBLE_NO_SSH=1. Trade-offs: known_hosts updates
  # from inside don't persist to host (fix on host with
  # `ssh -o StrictHostKeyChecking=accept-new ...`); on-disk keys without an
  # agent may hit StrictModes failures from the host-vs-vscode UID mismatch
  # (macOS 501 vs 1000) — workaround: start an ssh-agent on host
  # (`eval $(ssh-agent) && ssh-add <key>`) before launching pi-rukas.
  if [ "${PI_ENSEMBLE_NO_SSH-}" = "1" ]; then
    :
  else
    if [ -d "$HOME/.ssh" ]; then
      mounts+=(-v "$HOME/.ssh:/home/vscode/.ssh:ro")
    fi
    if [ -n "${SSH_AUTH_SOCK-}" ] && [ -S "${SSH_AUTH_SOCK}" ]; then
      mounts+=(-v "${SSH_AUTH_SOCK}:/run/host-ssh-auth.sock")
    fi
  fi

  # Named volumes (caches, shell history) — shared across all projects
  # using the same image, container-scoped, NOT bind-mounted from host.
  mounts+=(-v pi-ensemble-cache:/home/vscode/.cache)
  mounts+=(-v pi-ensemble-bun-cache:/home/vscode/.bun)
  mounts+=(-v pi-ensemble-cargo-cache:/home/vscode/.cargo)
  mounts+=(-v pi-ensemble-history:/commandhistory)
  # NUL-separated so multi-line values (FZF_DEFAULT_OPTS etc., though they
  # only appear in build_env in practice) survive the IPC into run_container.
  # Consistent IPC across build_mounts / build_env / build_host_aliases.
  printf '%s\0' "${mounts[@]}"
}

build_env() {
  # Env passthrough — forward the host shell's FULL env into the sandbox
  # EXCEPT vars on the blocklist. Why wholesale-forward (post-#228): host-mode
  # `pi` inherits the parent shell's env naturally; sandbox-mode should match
  # so `.pi/mcp.json` env-refs (`${VAR}` / `{env:VAR}`) Just Work. Same
  # transparency principle as the docker socket and SSH agent. The user is the
  # trust authority; the container is the agent's runtime, not a meaningful
  # security boundary (per feedback memory: "It needs to be completely
  # transparent to the user that pi just happens to run inside devcontainer").
  #
  # Blocklist categories:
  #   - container-identity conflicts: PATH, HOME, SHELL, PWD, OLDPWD, USER,
  #     LOGNAME, TMPDIR/TEMP/TMP, MAIL, HOSTNAME — the container has its own
  #   - shell internals: SHLVL, _
  #   - already wrapper-managed: SSH_AUTH_SOCK (re-set to /run/host-ssh-auth.sock
  #     by the dedicated block below), PI_ENSEMBLE_* (set explicitly farther down)
  #   - host-only paths that break inside: DOCKER_HOST — Colima / Podman set this
  #     to a path under /Users/<u>/.colima/... that doesn't exist in the sandbox;
  #     the container has /var/run/docker.sock bind-mounted and docker CLI falls
  #     back to it when DOCKER_HOST is unset (else: "failed to connect to docker
  #     API at <host-only-path>")
  #   - locale (LC_*), bash function exports (BASH_FUNC_*), system internals (__*)
  local blocklist_exact=" PATH HOME SHELL PWD OLDPWD USER LOGNAME TMPDIR TEMP TMP SHLVL _ MAIL HOSTNAME SSH_AUTH_SOCK DOCKER_HOST "
  local envs=()
  # NUL-separated parsing (env -0) so multi-line env values stay intact.
  # The naïve newline-split approach (`while read < <(env)`) splits values
  # that contain literal newlines (e.g. FZF_DEFAULT_OPTS, which is commonly
  # a multi-line config string), parsing the continuation lines as bogus
  # var names like `--height 40%` and breaking the ${!var-} lookup.
  # Available on both BSD env (macOS) and GNU env (Linux).
  local entry var value
  while IFS= read -r -d '' entry; do
    [[ -z "$entry" ]] && continue
    var="${entry%%=*}"
    value="${entry#*=}"
    # Defensive: skip anything that isn't a syntactically valid var name.
    # Catches e.g. lines that somehow lacked '=' and partial-entry edge
    # cases. Pure POSIX identifier shape: [A-Za-z_][A-Za-z0-9_]*
    [[ ! "$var" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] && continue
    # Skip exact-match blocklist (space-padded boundary)
    [[ "$blocklist_exact" == *" $var "* ]] && continue
    # Skip pattern blocklist
    case "$var" in
      LC_*|PI_ENSEMBLE_*|BASH_FUNC_*|__*) continue ;;
    esac
    # Skip empty values — no info, just clutter in `docker inspect`
    [[ -z "$value" ]] && continue
    envs+=(-e "$var=$value")
  done < <(env -0)
  # PI_ENSEMBLE_EXTRA_ENV is now a no-op (wholesale forwarding makes it
  # redundant). Kept tolerant: if a user has it set in their shell rc from
  # pre-#228 days, the listed vars are forwarded by the wholesale loop above
  # anyway — no breakage.

  # gh auth: if the user has gh installed and authenticated on host, extract
  # the token and forward as GH_TOKEN. This handles the common macOS case
  # where `gh auth login` stores the token in Keychain (not on disk at
  # ~/.config/gh/hosts.yml), making the bind-mount-alone strategy
  # insufficient. `gh auth token` works regardless of where the token
  # lives. Skip silently if gh isn't installed or no token is configured —
  # user can `gh auth login -h github.com` inside the container in that case.
  if [ -z "${GH_TOKEN-}" ] && [ -z "${GITHUB_TOKEN-}" ] && command -v gh >/dev/null 2>&1; then
    if gh_tok="$(gh auth token 2>/dev/null)" && [ -n "$gh_tok" ]; then
      envs+=(-e "GH_TOKEN=$gh_tok")
    fi
  fi
  # SSH agent forwarding — if the host has an agent running AND ssh isn't
  # explicitly opted out via PI_ENSEMBLE_NO_SSH=1, point the container's
  # SSH_AUTH_SOCK at the bind-mounted host socket (see build_mounts).
  if [ "${PI_ENSEMBLE_NO_SSH-}" != "1" ] && [ -n "${SSH_AUTH_SOCK-}" ] && [ -S "${SSH_AUTH_SOCK}" ]; then
    envs+=(-e "SSH_AUTH_SOCK=/run/host-ssh-auth.sock")
  fi

  # Container-only flags
  envs+=(-e PI_ENSEMBLE_SANDBOX_MODE=1)
  # Workspace root — used by sandbox-fs-guard to enforce the FS boundary.
  # Set to PROJECT_ROOT (the host absolute path mounted in by build_mounts)
  # so the guard's "outside the workspace" check works for the new mount
  # shape (#207 — was hard-coded /workspace).
  envs+=(-e "PI_ENSEMBLE_WORKSPACE_ROOT=$PROJECT_ROOT")
  # Additional allowed roots — sandbox-fs-guard treats paths under these as
  # in-bounds in addition to the workspace root. Wrapper sets this to the
  # same list of image-dirs build_mounts bind-mounts, so drag-and-dropped
  # images from $HOME/Downloads etc. work without blanket-allowing all FS
  # access. Mirrors PI_ENSEMBLE_IMAGE_DIRS / EXTRA_IMAGE_DIRS so the
  # mount-list and guard-allow-list stay in sync.
  local default_image_dirs="$HOME/Downloads:$HOME/Desktop:$HOME/Pictures"
  local guard_roots="${PI_ENSEMBLE_IMAGE_DIRS:-$default_image_dirs}"
  if [ -n "${PI_ENSEMBLE_EXTRA_IMAGE_DIRS-}" ]; then
    guard_roots="${guard_roots}:${PI_ENSEMBLE_EXTRA_IMAGE_DIRS}"
  fi
  # Filter to existing dirs only (extant_dirs preserves order, skips missing)
  local extant_dirs=""
  IFS=':' read -ra dir_list <<<"$guard_roots"
  for dir in "${dir_list[@]}"; do
    [ -z "$dir" ] && continue
    [ -d "$dir" ] || continue
    extant_dirs="${extant_dirs:+$extant_dirs:}$dir"
  done
  if [ -n "$extant_dirs" ]; then
    envs+=(-e "PI_ENSEMBLE_ALLOWED_ROOTS=$extant_dirs")
  fi
  envs+=(-e "HISTFILE=/commandhistory/.bash_history")
  # NUL-separated so multi-line env values (FZF_DEFAULT_OPTS etc., commonly
  # ~500 chars with 8+ embedded newlines) reach run_container intact. With
  # newline-separated IPC, multi-line values fragment into separate read-loop
  # iterations; docker then sees the continuation lines as positional args
  # and errors out with "docker: invalid reference format".
  printf '%s\0' "${envs[@]}"
}

build_host_aliases() {
  # Hostnames that exist on the host's network (Tailscale MagicDNS, LAN, /etc/hosts)
  # but won't resolve inside the container. Use `--add-host name:ip` to teach the
  # container's resolver. List is colon-separated `name:ip` pairs in
  # $PI_ENSEMBLE_HOST_ALIASES (env), with one well-known default:
  #
  #   PI_ENSEMBLE_HOST_ALIASES="halo:192.168.8.249,myserver:10.0.0.7"
  #
  # The default below registers `halo` (the LLM gateway documented in your
  # ~/.pi/agent/models.json). Override the env to add more or change the IP.
  local aliases=()
  local default_aliases="halo:192.168.8.249"
  local raw="${PI_ENSEMBLE_HOST_ALIASES:-$default_aliases}"
  IFS=',' read -ra pairs <<<"$raw"
  for pair in "${pairs[@]}"; do
    [ -z "$pair" ] && continue
    aliases+=(--add-host="$pair")
  done
  # NUL-separated for consistency with build_mounts / build_env IPC.
  printf '%s\0' "${aliases[@]}"
}

# Repair the host terminal after `docker run -it`. Pi inside the container
# runs in TUI mode (alt-screen + raw input + hidden cursor). If the container
# exits abruptly (OOM-kill, segfault, dispatch_lens_review fanout overrun,
# etc.), Pi never gets a chance to exit alt-screen / restore terminal modes,
# and the host shell is left in a corrupted state: typing produces "weird
# UTF-8 characters", the cursor is invisible, scrollback is gone. The
# commands below are all no-ops on a clean terminal, so safe to run on every
# exit path. Only fires when stdout is a TTY (skips piped invocations).
repair_tty() {
  if [ -t 1 ]; then
    stty sane 2>/dev/null || true
    tput rmcup 2>/dev/null || true   # exit alt-screen
    tput cnorm 2>/dev/null || true   # show cursor
  fi
}

run_container() {
  local cmd=("$@")
  local mounts=()
  local envs=()
  local hosts=()
  local line
  # NUL-separated IPC — see build_mounts/build_env/build_host_aliases. With
  # newline-separated, multi-line env values (e.g. FZF_DEFAULT_OPTS) fragment
  # into bogus -e/-v args and docker run errors with "invalid reference format".
  while IFS= read -r -d '' line; do mounts+=("$line"); done < <(build_mounts)
  while IFS= read -r -d '' line; do envs+=("$line"); done < <(build_env)
  while IFS= read -r -d '' line; do hosts+=("$line"); done < <(build_host_aliases)
  # #933: entrypoint repairs legacy root-owned NAMED volumes; tell it which
  # allowlisted paths are volumes, not bind mounts (path/socket source).
  local vol_targets=()
  for line in "${mounts[@]}"; do
    local src="${line#-v }"
    case "$src" in
      */*) ;;  # bind mount (path / socket source) — never a named volume
      *)  vol_targets+=("${src#*:}") ;;
    esac
  done
  if [ "${#vol_targets[@]}" -gt 0 ]; then
    envs+=(-e "PI_ENSEMBLE_VOLUME_MOUNTS=$(IFS=:; echo "${vol_targets[*]}")")
  fi
  # Ensure terminal gets cleaned up even if docker run exits non-zero
  # (Pi crashed, OOM, etc.). Without this, the host shell is unusable.
  trap repair_tty EXIT
  docker run --rm -it \
    --name "$CONTAINER_NAME" \
    -w "$PROJECT_ROOT" \
    "${mounts[@]}" \
    "${envs[@]}" \
    "${hosts[@]}" \
    "$IMAGE" \
    "${cmd[@]}"
}

cmd_default() {
  require_docker
  ensure_image
  run_container pi "$@"
}

cmd_shell() {
  require_docker
  ensure_image
  run_container bash
}

cmd_rebuild() {
  require_docker
  docker build -t "$IMAGE" -f "$REPO_DIR/.devcontainer/Dockerfile" "$REPO_DIR"
}

cmd_stop() {
  require_docker
  local matches
  matches="$(docker ps --format '{{.Names}}' | grep -E "^${BASE_NAME}-" || true)"
  if [ -z "$matches" ]; then
    echo "No running pi-rukas container for $PROJECT_ROOT"
    return
  fi
  local count
  count=$(printf '%s\n' "$matches" | wc -l | tr -d ' ')
  echo "Stopping $count pi-rukas container(s) for $PROJECT_ROOT:"
  printf '%s\n' "$matches" | while IFS= read -r name; do
    docker stop "$name"
  done
}

cmd_logs() {
  require_docker
  local matches count
  matches="$(docker ps --format '{{.Names}}' | grep -E "^${BASE_NAME}-" || true)"
  count=$(printf '%s' "$matches" | grep -c . || true)
  if [ "$count" -eq 0 ]; then
    echo "No running pi-rukas container for $PROJECT_ROOT" >&2
    exit 1
  fi
  if [ "$count" -eq 1 ]; then
    docker logs -f "$matches"
    return
  fi
  echo "Multiple pi-rukas containers running for $PROJECT_ROOT:" >&2
  printf '%s\n' "$matches" | sed 's/^/  /' >&2
  echo "Specify one: docker logs -f <name>" >&2
  exit 1
}

cmd_status() {
  require_docker
  local matches
  matches="$(docker ps --format '{{.Names}}\t{{.Status}}' | grep -E "^${BASE_NAME}-" || true)"
  if [ -z "$matches" ]; then
    echo "No running pi-rukas container for $PROJECT_ROOT"
    return
  fi
  printf 'NAMES\tSTATUS\n%s\n' "$matches"
}

# ----- dispatch -----
case "${1:-}" in
  ""|--)        shift || true; cmd_default "$@" ;;
  shell)        cmd_shell ;;
  rebuild)      cmd_rebuild ;;
  stop)         cmd_stop ;;
  prune)        cmd_prune ;;
  logs)         cmd_logs ;;
  status)       cmd_status ;;
  -h|--help|help) usage ;;
  *)            cmd_default "$@" ;;
esac
