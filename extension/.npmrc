# Defense-in-depth for the npm fallback path that install.sh uses when bun is
# absent — mirrors bunfig.toml's `minimumReleaseAge` setting for that path.
#
# bun is the primary, reproducibility-guaranteed package manager (bun.lock
# committed, CI runs `bun install --frozen-lockfile`). npm is a functional
# fallback, not a pinned one: there is no committed package-lock.json, so
# npm-resolved versions are embargo-bounded but not pinned to bun's bun.lock
# tree.
#
# - npm 11.10.0+ honors `min-release-age` (days); pnpm 9.0+ honors the same key
#   (pnpm is not an install path here — this is the .npmrc config-file
#   mechanism, which applies if pnpm ever reads this file)
# - older clients silently ignore it
#
# Keep this in sync with the seconds value in bunfig.toml.

min-release-age=4

# Refuse to install when the runtime doesn't satisfy `engines` in package.json.
# Forces the npm fallback path onto a version new enough to enforce min-release-age.
engine-strict=true
